{
  "name": "ingress-banner-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive archive for Ingress banners (mission banners) built with React, Vite and MapLibre GL.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantonres/ingress-banner-atlas.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"tests-js/*.test.js\"",
    "test:browser": "npm run build && node scripts/check-map-browser.mjs",
    "test:browser:dev": "node scripts/check-map-browser.mjs --dev",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.2.6",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "vite": "^8.3.8"
  }
}
